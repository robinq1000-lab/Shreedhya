{% liquid
  assign section_id = section.id
%}

<shoppable-reels
  id="ShoppableReels-{{ section_id }}"
  class="sr sr-{{ section_id }}"
  data-section-id="{{ section_id }}"
  style="
    --sr-heading-size: {{ section.settings.heading_size }}px;
    --sr-bg: {{ section.settings.bg_color }};
    --sr-text: {{ section.settings.text_color }};
    --sr-button-bg: {{ section.settings.button_bg }};
    --sr-button-text: {{ section.settings.button_text }};
    --sr-discount: {{ section.settings.discount_color }};
    --sr-sheet-text: {{ section.settings.sheet_text_color | default: '#652D1C' }};
    --sr-sheet-btn: {{ section.settings.sheet_button_bg | default: '#652D1C' }};
    --sr-sheet-btn-text: {{ section.settings.sheet_button_text | default: '#FFFFFF' }};
    --sr-sheet-offer: {{ section.settings.sheet_offer_color | default: '#ab2f20' }};
    --sr-card-width: {{ section.settings.card_width_desktop }}px;
    --sr-gap: {{ section.settings.card_gap }}px;
    --sr-radius: {{ section.settings.card_radius }}px;
    --sr-padding-top: {{ section.settings.padding_top }}px;
    --sr-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sr-padding-inline: {{ section.settings.padding_left_right }}px;
  "
  data-popup-autoplay-next="{{ section.settings.popup_autoplay_next }}"
  data-sheet-auto-open="{{ section.settings.sheet_auto_open }}"
>
  <section class="sr-section" aria-label="{{ section.settings.heading | default: 'Shoppable reels' | escape }}">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="sr-header sr-header--{{ section.settings.text_alignment }}">
        {% if section.settings.heading != blank %}
          <h2 class="sr-heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="sr-subheading">{{ section.settings.subheading | escape | newline_to_br }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="sr-carousel">
        {% if section.settings.show_arrows %}
          <button class="sr-arrow sr-arrow--prev" type="button" aria-label="Scroll reels left" data-carousel-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
        {% endif %}
        <div class="sr-track" data-track role="list">
          {% for block in section.blocks %}
            {% liquid
              assign reel_video_src = blank
              assign reel_poster = block.settings.cover_image

              if block.settings.video != blank
                assign video_sources = block.settings.video.sources | where: 'mime_type', 'video/mp4' | sort: 'width'
                if video_sources.size > 0
                  assign chosen_video_source = video_sources.first
                  for source in video_sources
                    if source.width >= 600 and source.width <= 900
                      assign chosen_video_source = source
                      break
                    endif
                  endfor
                  assign reel_video_src = chosen_video_source.url
                endif
                if reel_poster == blank
                  assign reel_poster = block.settings.video.preview_image
                endif
              endif

              if reel_video_src == blank and block.settings.video_url != blank
                assign reel_video_src = block.settings.video_url | strip
              endif

              if reel_video_src == blank and block.settings.product != blank
                if block.settings.product.metafields.custom.reel_video != blank
                  assign meta_val = block.settings.product.metafields.custom.reel_video
                  if meta_val.sources != blank
                    assign reel_video_src = meta_val.sources.first.url
                  elsif meta_val.value != blank
                    assign reel_video_src = meta_val.value
                  else
                    assign reel_video_src = meta_val
                  endif
                elsif block.settings.product.metafields.custom.video != blank
                  assign meta_val = block.settings.product.metafields.custom.video
                  if meta_val.sources != blank
                    assign reel_video_src = meta_val.sources.first.url
                  elsif meta_val.value != blank
                    assign reel_video_src = meta_val.value
                  else
                    assign reel_video_src = meta_val
                  endif
                endif
              endif

              assign reel_product = block.settings.product
              assign reel_variant = blank
              assign reel_discount = 0
              if reel_product != blank
                assign reel_variant = reel_product.selected_or_first_available_variant
                if reel_poster == blank and reel_product.featured_image != blank
                  assign reel_poster = reel_product.featured_image
                endif
                if reel_variant.compare_at_price > reel_variant.price
                  assign discount_difference = reel_variant.compare_at_price | minus: reel_variant.price
                  assign discount_percent = discount_difference | times: 100.0 | divided_by: reel_variant.compare_at_price | round
                  assign reel_discount = discount_percent
                endif
              endif

              assign reel_poster_url = blank
              if reel_poster != blank
                assign reel_poster_url = reel_poster | image_url: width: 1000
              endif

              assign display_views = block.settings.view_count
              if display_views == blank
                assign calc_v = forloop.index | times: 17 | plus: 25
                if calc_v > 90
                  assign calc_v = calc_v | modulo: 65 | plus: 20
                endif
                assign display_views = calc_v | append: '.' | append: forloop.index | append: 'k'
              endif
            %}
            <article
              class="sr-item"
              role="listitem"
              data-reel-card
              data-reel-index="{{ forloop.index0 }}"
              data-video-src="{{ reel_video_src | escape }}"
              data-poster="{{ reel_poster_url | escape }}"
              data-view-count="{{ display_views | escape }}"
              data-likes="{{ block.settings.likes | default: '380' | escape }}"
              {% if reel_product != blank and reel_variant != blank %}
                data-product-variant="{{ reel_variant.id }}"
                data-product-title="{{ reel_product.title | escape }}"
                data-product-url="{{ reel_product.url | escape }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {% if reel_product != blank %}
                <script type="application/json" data-product-json>
                  {
                    "id": {{ reel_product.id | json }},
                    "title": {{ reel_product.title | json }},
                    "url": {{ reel_product.url | json }},
                    "featured_image": {% if reel_product.featured_image != blank %}{{ reel_product.featured_image | image_url: width: 700 | json }}{% else %}""{% endif %},
                    "images": [
                      {% for img in reel_product.images limit: 8 %}
                        {{ img | image_url: width: 700 | json }}{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ],
                    "options": [
                      {% for option in reel_product.options_with_values %}
                        {
                          "name": {{ option.name | json }},
                          "position": {{ option.position }},
                          "values": [
                            {% for val in option.values %}
                              {{ val | json }}{% unless forloop.last %},{% endunless %}
                            {% endfor %}
                          ]
                        }{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ],
                    "variants": [
                      {% for v in reel_product.variants %}
                        {
                          "id": {{ v.id }},
                          "available": {% if v.available %}true{% else %}false{% endif %},
                          "price": {{ v.price | money | json }},
                          "price_cents": {{ v.price }},
                          "compare_at_price": {% if v.compare_at_price and v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
                          "compare_cents": {{ v.compare_at_price | default: 0 }},
                          "image": {% if v.featured_image %}{{ v.featured_image | image_url: width: 700 | json }}{% else %}null{% endif %},
                          "options": [
                            {% for opt in v.options %}
                              {{ opt | json }}{% unless forloop.last %},{% endunless %}
                            {% endfor %}
                          ]
                        }{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ]
                  }
                </script>
              {% endif %}
              <div class="sr-reel-frame">
                <button
                  class="sr-reel-card"
                  type="button"
                  data-open-reel
                  aria-label="Open reel {{ forloop.index }}{% if reel_product != blank %}: {{ reel_product.title | escape }}{% endif %}"
                >
                  {% if reel_poster_url != blank %}
                    <img
                      class="sr-reel-poster"
                      src="{{ reel_poster_url }}"
                      alt="{{ reel_product.title | default: 'Reel' | escape }}"
                      loading="lazy"
                      decoding="async"
                      width="720"
                      height="1280"
                    >
                  {% else %}
                    <div class="sr-reel-placeholder" aria-hidden="true">
                      <svg viewBox="0 0 48 48"><path d="m19 13 17 11-17 11z"/></svg>
                      <span>Add video</span>
                    </div>
                  {% endif %}

                  {% if reel_video_src != blank %}
                    <video
                      class="sr-card-video"
                      data-carousel-video
                      {% if forloop.index <= 2 %}
                        src="{{ reel_video_src | escape }}"
                      {% else %}
                        data-src="{{ reel_video_src | escape }}"
                      {% endif %}
                      {% if reel_poster_url != blank %}poster="{{ reel_poster_url }}"{% endif %}
                      muted
                      loop
                      playsinline
                      preload="none"
                      tabindex="-1"
                      aria-hidden="true"
                    ></video>
                  {% endif %}

                  <span class="sr-views">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6Z"/><circle cx="12" cy="12" r="2.7"/></svg>
                    <span>{{ display_views | escape }}</span>
                  </span>
                </button>

                {% if reel_video_src != blank %}
                  <button class="sr-sound-toggle" type="button" data-carousel-sound aria-label="Unmute reel" aria-pressed="false">
                    <svg class="sr-icon-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="m16 9 5 6m0-6-5 6"/></svg>
                    <svg class="sr-icon-unmuted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7m3-10a9 9 0 0 1 0 13"/></svg>
                  </button>
                {% endif %}
              </div>

              {% if reel_product != blank and reel_variant != blank %}
                <div class="sr-product-row">
                  <a class="sr-product-link" href="{{ reel_product.url }}">
                    {% if reel_product.featured_image != blank %}
                      <img
                        class="sr-product-thumb"
                        src="{{ reel_product.featured_image | image_url: width: 160 }}"
                        alt="{{ reel_product.featured_image.alt | default: reel_product.title | escape }}"
                        loading="lazy"
                        decoding="async"
                        width="64"
                        height="64"
                      >
                    {% else %}
                      <span class="sr-product-thumb sr-product-thumb--empty" aria-hidden="true"></span>
                    {% endif %}
                    <span class="sr-product-copy">
                      <span class="sr-product-title">{{ reel_product.title | escape }}</span>
                      <span class="sr-price-line">
                        <span class="sr-price">{{ reel_variant.price | money }}</span>
                        {% if reel_discount > 0 %}
                          <s class="sr-compare">{{ reel_variant.compare_at_price | money }}</s>
                          <span class="sr-discount">{{ reel_discount }}% OFF</span>
                        {% endif %}
                      </span>
                    </span>
                  </a>

                  <div class="sr-card-actions">
                    <button
                      class="sr-view-button"
                      type="button"
                      data-card-view-details
                      data-reel-index="{{ forloop.index0 }}"
                      aria-label="View details for {{ reel_product.title | escape }}"
                    >
                      <span>View Details</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
                    {% if reel_variant.available %}
                      <button
                        class="sr-buy-button"
                        type="button"
                        data-card-buy-now
                        data-magic-checkout="true"
                        data-reel-index="{{ forloop.index0 }}"
                        aria-label="Buy {{ reel_product.title | escape }} now"
                      >
                        {% comment %} <span class="sr-buy-bolt">⚡</span> {% endcomment %}
                        <span>Buy Now</span>
                      </button>
                    {% else %}
                      <button class="sr-buy-button sr-buy-button--disabled" type="button" disabled>Sold out</button>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
        {% if section.settings.show_arrows %}
          <button class="sr-arrow sr-arrow--next" type="button" aria-label="Scroll reels right" data-carousel-next>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        {% endif %}
      </div>
    {% else %}
      <div class="sr-empty-state">
        <div class="sr-empty-state__icon">
          <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="9" y="5" width="30" height="38" rx="6"/><path d="m20 16 11 8-11 8z"/></svg>
        </div>
        <p>Add reel blocks to show shoppable videos here.</p>
      </div>
    {% endif %}
  </section>

  {% if section.blocks.size > 0 %}
    <div class="sr-viewer" data-viewer hidden aria-hidden="true">
      <button class="sr-viewer-backdrop" type="button" data-close-viewer aria-label="Close reel viewer" tabindex="-1"></button>
      <button class="sr-viewer-close" type="button" data-close-viewer aria-label="Close">
        <span>Close</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>

      <button class="sr-viewer-arrow sr-viewer-arrow--prev" type="button" data-viewer-prev aria-label="Previous reel">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="sr-viewer-stage" data-viewer-stage role="dialog" aria-modal="true" aria-label="Shoppable reel viewer">
        <button class="sr-viewer-slot sr-viewer-slot--prev" type="button" data-viewer-slot="prev" aria-label="Show previous reel">
          <img alt="" data-slot-image width="720" height="1280" decoding="async">
          <span class="sr-slot-label"><span>‹ Previous</span></span>
        </button>

        <div class="sr-viewer-slot sr-viewer-slot--active" data-viewer-slot="active">
          <img class="sr-active-poster" alt="" data-active-image width="720" height="1280" decoding="async">
          <video class="sr-active-video" data-active-video playsinline preload="auto" loop></video>

          <button class="sr-viewer-video-hitarea" type="button" data-toggle-play aria-label="Pause video"></button>

          <div class="sr-viewer-top-bar">
            <div class="sr-progress" aria-hidden="true"><span data-progress></span></div>
            <div class="sr-viewer-top-actions">
              <div class="sr-viewer-top-group">
                <button class="sr-top-btn" type="button" data-close-viewer aria-label="Close">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
                <button class="sr-top-btn" type="button" data-share aria-label="Share reel">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="m8.3 10.8 7.4-4.4M8.3 13.2l7.4 4.4"/></svg>
                </button>
              </div>
              <div class="sr-viewer-top-group">
                <button class="sr-top-btn" type="button" data-viewer-mute aria-label="Mute video" aria-pressed="false">
                  <svg class="sr-icon-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="m16 9 5 6m0-6-5 6"/></svg>
                  <svg class="sr-icon-unmuted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7m3-10a9 9 0 0 1 0 13"/></svg>
                </button>
                <button class="sr-top-btn" type="button" data-toggle-play aria-label="Pause video">
                  <svg class="sr-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
                  <svg class="sr-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5z"/></svg>
                </button>
              </div>
            </div>
          </div>

          <div class="sr-viewer-bottom" data-viewer-bottom hidden>
            <button class="sr-viewer-bottom-bar" type="button" data-expand-sheet aria-label="Open product options">
              <img alt="" data-bottom-image width="42" height="42" decoding="async">
              <span class="sr-viewer-bottom-info">
                <span class="sr-viewer-bottom-title" data-bottom-title></span>
                <span class="sr-viewer-bottom-price" data-bottom-price></span>
              </span>
              <span class="sr-viewer-bottom-open-btn">
                <span data-bottom-cta>Select Size</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
              </span>
            </button>
          </div>

          <div class="sr-sheet" data-sheet role="region" aria-label="Product options" aria-hidden="true" inert>
            <button class="sr-sheet-handle" type="button" data-collapse-sheet aria-label="Hide product options">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>

            <div class="sr-sheet-scroll" data-sheet-scroll>
              <div class="sr-sheet-media">
                <button class="sr-sheet-nav sr-sheet-nav--prev" type="button" data-sheet-img-prev aria-label="Previous image" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <img class="sr-sheet-img" data-sheet-image alt="" width="96" height="140" decoding="async">
                <button class="sr-sheet-nav sr-sheet-nav--next" type="button" data-sheet-img-next aria-label="Next image" hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
              </div>

              <h3 class="sr-sheet-title" data-sheet-title></h3>

              <div class="sr-sheet-price-row">
                <span class="sr-sheet-price" data-sheet-price></span>
                <s class="sr-sheet-compare" data-sheet-compare hidden></s>
                <span class="sr-sheet-offer" data-sheet-offer hidden></span>
              </div>

              <div class="sr-sheet-divider"></div>
              <div class="sr-sheet-options" data-sheet-options></div>
            </div>

            <div class="sr-sheet-footer">
              <p class="sr-sheet-hint" data-sheet-hint role="alert" hidden></p>
              <div class="sr-sheet-buttons">
                <button class="sr-sheet-add" type="button" data-sheet-add data-state="idle">
                  <span class="sr-lbl-add">Add To Cart</span>
                  <span class="sr-lbl-added">Added ✓</span>
                  <span class="sr-spinner" aria-hidden="true"></span>
                </button>
                <button class="sr-sheet-cart" type="button" data-open-cart-drawer aria-label="Open cart">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 2h3l1 3"/></svg>
                  <span class="sr-sheet-badge" data-sheet-cart-count>{{ cart.item_count }}</span>
                </button>
              </div>
              <button class="sr-sheet-buy" type="button" data-sheet-magic-buy data-magic-checkout="true" aria-label="Buy now with UPI or cards">
                {% comment %} <span class="sr-buy-bolt">⚡</span> {% endcomment %}
                <span>Buy Now · UPI / Cards</span>
              </button>
              <a class="sr-sheet-full" href="#" data-sheet-product-url>View Full Product Details</a>
            </div>
          </div>
        </div>

        <button class="sr-viewer-slot sr-viewer-slot--next" type="button" data-viewer-slot="next" aria-label="Show next reel">
          <img alt="" data-slot-image width="720" height="1280" decoding="async">
          <span class="sr-slot-label"><span>Next ›</span></span>
        </button>

        <div class="sr-viewer-actions">
          <button class="sr-like-button" type="button" data-like aria-pressed="false" aria-label="Like this reel">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.7c0 5.1-8.8 10.1-8.8 10.1S3.2 13.8 3.2 8.7A4.7 4.7 0 0 1 12 6.3a4.7 4.7 0 0 1 8.8 2.4Z"/></svg>
            <span><span data-like-count>0</span> Likes</span>
          </button>
          <div class="sr-menu-wrap">
            <button class="sr-menu-button" type="button" data-menu aria-label="More options" aria-expanded="false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>
            </button>
            <div class="sr-menu" data-menu-panel hidden>
              <button type="button" data-share>Share reel</button>
            </div>
          </div>
        </div>
      </div>

      <button class="sr-viewer-arrow sr-viewer-arrow--next" type="button" data-viewer-next aria-label="Next reel">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  {% endif %}

  <div id="magic-checkout-data-container"><script src="https://magic-plugins.razorpay.com/shopify/magic-shopify.js" crossorigin="anonymous" defer></script><script id="RazorpayMagicCheckoutConfig" type="application/json">{"oneClickCheckoutEnabled":"{{shop.metafields.magic_checkout.oneClickCheckoutEnabled}}","buyNowEnabled":"{{shop.metafields.magic_checkout.buyNowEnabled}}","config":{{shop.metafields.magic_checkout.config}},"email":"{{customer.email}}","phone":"{{customer.phone}}"}</script></div>
</shoppable-reels>

{% style %}
  .sr { display: block; background: var(--sr-bg); color: var(--sr-text); padding: var(--sr-padding-top) var(--sr-padding-inline) var(--sr-padding-bottom); overflow: hidden; box-sizing: border-box; }
  .sr *, .sr *::before, .sr *::after { box-sizing: border-box; }
  .sr [hidden] { display: none !important; }
  .sr button, .sr a { -webkit-tap-highlight-color: transparent; }
  .sr button { font: inherit; }
  .sr svg { flex-shrink: 0; }
  .sr .sr-section { width: 100%; max-width: 1720px; margin: 0 auto; }
  .sr .sr-header { margin: 0 0 20px; }
  .sr .sr-header--center { text-align: center; }
  .sr .sr-heading { color: var(--sr-text); font-size: var(--sr-heading-size); line-height: 1.2; font-weight: 600; margin: 0; }
  .sr .sr-subheading { color: var(--sr-text); opacity: .72; font-size: 14px; line-height: 1.5; margin: 6px 0 0; }
  .sr .sr-carousel { position: relative; }
  .sr .sr-track { display: flex; gap: var(--sr-gap); overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; padding: 3px 2px 8px; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
  .sr .sr-track::-webkit-scrollbar { display: none; }
  .sr .sr-item { position: relative; flex: 0 0 var(--sr-card-width); min-width: 0; scroll-snap-align: start; }
  .sr .sr-reel-frame { position: relative; width: 100%; }
  .sr .sr-reel-card { position: relative; display: block; width: 100%; padding: 0; aspect-ratio: 9 / 16; overflow: hidden; border: 1px solid #e5e5e5; border-radius: var(--sr-radius); background: #000; box-shadow: 0 4px 14px rgba(0,0,0,.08); color: inherit; cursor: pointer; text-align: left; isolation: isolate; }
  .sr .sr-reel-poster, .sr .sr-card-video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .sr .sr-reel-poster { z-index: 0; }
  .sr .sr-card-video { z-index: 1; background: transparent; }
