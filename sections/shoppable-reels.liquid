        this.viewer = this.querySelector('[data-viewer]');
        this.cards = Array.from(this.querySelectorAll('[data-reel-card]'));
        this.cardVideos = Array.from(this.querySelectorAll('[data-carousel-video]'));
        this.state = { open: false, index: 0, sheetOpen: false, muted: false, paused: false };
        this.cache = new Map();
        this.visible = new Set();
        this.sel = [];
        this.images = [];
        this.imageIndex = 0;
        this.product = null;
        this._token = 0;
        this.r = this.viewer ? this.refs() : null;
        if (this.viewer && this.cards.length < 2) this.viewer.classList.add('is-single');
        this.bind();
        this.observeCards();
        this.updateArrows();
      }

      disconnectedCallback() {
        if (!this._ready) return;
        this._ready = false;
        this.removeEventListener('click', this._onClick);
        window.removeEventListener('resize', this._onScroll);
        document.removeEventListener('visibilitychange', this._onVis);
        document.removeEventListener('keydown', this._onKey);
        if (this.track) this.track.removeEventListener('scroll', this._onScroll);
        if (this.io) this.io.disconnect();
        if (this._raf) cancelAnimationFrame(this._raf);
        if (this.state.open) document.body.style.overflow = this._prevOverflow || '';
        this.cardVideos.forEach((v) => v.pause());
      }

      refs() {
        const q = (s) => this.viewer.querySelector(s);
        return {
          prev: q('[data-viewer-slot="prev"]'),
          next: q('[data-viewer-slot="next"]'),
          img: q('[data-active-image]'),
          video: q('[data-active-video]'),
          hit: q('.sr-viewer-video-hitarea'),
          progress: q('[data-progress]'),
          mute: q('[data-viewer-mute]'),
          plays: Array.from(this.viewer.querySelectorAll('[data-toggle-play]')),
          bottom: q('[data-viewer-bottom]'),
          bottomImg: q('[data-bottom-image]'),
          bottomTitle: q('[data-bottom-title]'),
          bottomPrice: q('[data-bottom-price]'),
          bottomCta: q('[data-bottom-cta]'),
          sheet: q('[data-sheet]'),
          scroll: q('[data-sheet-scroll]'),
          sheetImg: q('[data-sheet-image]'),
          imgPrev: q('[data-sheet-img-prev]'),
          imgNext: q('[data-sheet-img-next]'),
          title: q('[data-sheet-title]'),
          price: q('[data-sheet-price]'),
          compare: q('[data-sheet-compare]'),
          offer: q('[data-sheet-offer]'),
          options: q('[data-sheet-options]'),
          hint: q('[data-sheet-hint]'),
          add: q('[data-sheet-add]'),
          addLabel: q('.sr-lbl-add'),
          buy: q('[data-sheet-magic-buy]'),
          badge: q('[data-sheet-cart-count]'),
          full: q('[data-sheet-product-url]'),
          like: q('[data-like]'),
          likeCount: q('[data-like-count]'),
          menu: q('[data-menu-panel]'),
          menuBtn: q('[data-menu]'),
          close: q('.sr-viewer-close')
        };
      }

      bind() {
        this._onClick = (e) => this.onClick(e);
        this.addEventListener('click', this._onClick);
        this._onScroll = () => this.scheduleArrows();
        if (this.track) this.track.addEventListener('scroll', this._onScroll, { passive: true });
        window.addEventListener('resize', this._onScroll, { passive: true });
        this._onVis = () => this.syncCarousel();
        document.addEventListener('visibilitychange', this._onVis);
        this._onKey = (e) => this.onKey(e);

        if (!this.r) return;
        const v = this.r.video;
        v.addEventListener('playing', () => v.classList.add('is-ready'));
        v.addEventListener('timeupdate', () => this.updateProgress());
        v.addEventListener('ended', () => {
          if (this.autoNext && this.cards.length > 1) this.showReel(this.state.index + 1);
        });

        // Swipe (up/down or left/right) to change reels on touch screens
        let sx = 0, sy = 0, on = false;
        this.r.hit.addEventListener('touchstart', (e) => {
          if (e.touches.length !== 1) return;
          sx = e.touches[0].clientX;
          sy = e.touches[0].clientY;
          on = true;
        }, { passive: true });
        this.r.hit.addEventListener('touchend', (e) => {
          if (!on) return;
          on = false;
          const t = e.changedTouches[0];
          const dx = t.clientX - sx;
          const dy = t.clientY - sy;
          if (Math.max(Math.abs(dx), Math.abs(dy)) < 50) return;
          this._swipeAt = Date.now();
          const forward = Math.abs(dy) > Math.abs(dx) ? dy < 0 : dx < 0;
          this.navigate(forward ? 1 : -1);
        }, { passive: true });
      }

      onKey(e) {
        if (!this.state.open) return;
        if (e.key === 'Escape') {
          if (!this.r.menu.hidden) this.closeMenu();
          else this.closeViewer();
        } else if (e.key === 'ArrowRight') this.navigate(1);
        else if (e.key === 'ArrowLeft') this.navigate(-1);
      }

      onClick(e) {
        const t = e.target;
        const hit = (s) => t.closest(s);
        let el;

        if (hit('[data-carousel-sound]')) { e.preventDefault(); e.stopPropagation(); this.toggleCardSound(hit('[data-carousel-sound]')); return; }
        if ((el = hit('[data-card-view-details],[data-card-buy-now]'))) { e.preventDefault(); this.openViewer(Number(el.dataset.reelIndex), { sheet: true }); return; }
        if ((el = hit('[data-open-reel]'))) { const card = el.closest('[data-reel-card]'); if (card) this.openViewer(Number(card.dataset.reelIndex), { sheet: this.autoOpenSheet }); return; }
        if (hit('[data-carousel-prev]')) { this.scrollCarousel(-1); return; }
        if (hit('[data-carousel-next]')) { this.scrollCarousel(1); return; }
        if (!this.state.open) return;

        if (!hit('[data-menu]') && !hit('[data-menu-panel]')) this.closeMenu();

        if ((el = hit('[data-pill]'))) { e.preventDefault(); this.selectOption(Number(el.dataset.pos), el.dataset.val); return; }
        if (hit('[data-sheet-add]')) { e.preventDefault(); this.addToCart(); return; }
        if (hit('[data-sheet-magic-buy]')) { e.preventDefault(); this.buyNow(); return; }
        if (hit('[data-open-cart-drawer]')) { e.preventDefault(); this.closeViewer(); this.openCart(); return; }
        if (hit('[data-collapse-sheet]')) { e.preventDefault(); this.setSheetOpen(false); return; }
        if (hit('[data-expand-sheet]')) { e.preventDefault(); this.setSheetOpen(true); return; }
        if (hit('[data-sheet-img-next]')) { e.preventDefault(); this.stepImage(1); return; }
        if (hit('[data-sheet-img-prev]')) { e.preventDefault(); this.stepImage(-1); return; }
        if (hit('[data-close-viewer]')) { e.preventDefault(); this.closeViewer(); return; }
        if (hit('[data-viewer-prev]')) { this.navigate(-1); return; }
        if (hit('[data-viewer-next]')) { this.navigate(1); return; }
        if ((el = hit('[data-viewer-slot]'))) {
          if (el.dataset.viewerSlot === 'prev') this.navigate(-1);
          else if (el.dataset.viewerSlot === 'next') this.navigate(1);
          return;
        }
        if (hit('[data-toggle-play]')) {
          if (this._swipeAt && Date.now() - this._swipeAt < 400) return;
          this.togglePlay();
          return;
        }
        if (hit('[data-viewer-mute]')) { this.setMuted(!this.state.muted); return; }
        if (hit('[data-like]')) { this.toggleLike(); return; }
        if (hit('[data-menu]')) { this.toggleMenu(); return; }
        if (hit('[data-share]')) { this.shareCurrent(); }
      }

      /* ---------- Carousel ---------- */
      observeCards() {
        if (!('IntersectionObserver' in window)) {
          this.cardVideos.forEach((v) => { this.ensureSrc(v); this.visible.add(v); });
          this.syncCarousel();
          return;
        }
        this.io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            const v = en.target.querySelector('[data-carousel-video]');
            if (!v) return;
            if (en.intersectionRatio > 0) this.ensureSrc(v);
            if (en.intersectionRatio >= 0.35) this.visible.add(v);
            else this.visible.delete(v);
          });
          this.syncCarousel();
        }, { threshold: [0, 0.35] });
        this.cards.forEach((c) => this.io.observe(c));
      }

      ensureSrc(v) {
        if (!v.getAttribute('src') && v.dataset.src) {
          v.preload = 'metadata';
          v.src = v.dataset.src;
        }
      }

      syncCarousel() {
        const allow = !this.state.open && !document.hidden;
        this.cardVideos.forEach((v) => {
          if (allow && this.visible.has(v)) {
            if (v.paused) { const p = v.play(); if (p && p.catch) p.catch(() => {}); }
          } else if (!v.paused) v.pause();
        });
      }

      toggleCardSound(btn) {
        const card = btn.closest('[data-reel-card]');
        const video = card && card.querySelector('[data-carousel-video]');
        if (!video) return;
        const unmute = video.muted;
        this.cardVideos.forEach((o) => {
          o.muted = true;
          const b = o.closest('[data-reel-card]').querySelector('[data-carousel-sound]');
          if (b) { b.setAttribute('aria-pressed', 'false'); b.setAttribute('aria-label', 'Unmute reel'); }
        });
        if (unmute) {
          video.muted = false;
          btn.setAttribute('aria-pressed', 'true');
          btn.setAttribute('aria-label', 'Mute reel');
          const p = video.play();
          if (p && p.catch) p.catch(() => {});
        }
      }

      scrollCarousel(dir) {
        if (!this.track) return;
        const first = this.track.querySelector('[data-reel-card]');
        const gap = parseFloat(getComputedStyle(this.track).columnGap) || 16;
        const w = (first ? first.getBoundingClientRect().width : 280) + gap;
        this.track.scrollBy({ left: dir * w * 2, behavior: 'smooth' });
      }

      scheduleArrows() {
        if (this._raf) return;
        this._raf = requestAnimationFrame(() => { this._raf = 0; this.updateArrows(); });
      }

      updateArrows() {
        if (!this.track) return;
        const max = Math.max(0, this.track.scrollWidth - this.track.clientWidth);
        const p = this.querySelector('[data-carousel-prev]');
        const n = this.querySelector('[data-carousel-next]');
        if (p) p.disabled = this.track.scrollLeft <= 4;
        if (n) n.disabled = this.track.scrollLeft >= max - 4;
      }

      /* ---------- Viewer ---------- */
      openViewer(index, opts = {}) {
        if (!this.viewer || !this.cards.length || this.state.open) return;
        this._opener = document.activeElement;
        this.state.open = true;
        this.state.sheetOpen = !!opts.sheet;
        this.syncCarousel();
        this._prevOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        this.viewer.hidden = false;
        this.viewer.setAttribute('aria-hidden', 'false');
        document.addEventListener('keydown', this._onKey);
        this.showReel(index);
        if (this.r.close && this.r.close.offsetParent) this.r.close.focus({ preventScroll: true });
      }

      closeViewer() {
        if (!this.state.open) return;
        this.state.open = false;
        this.state.sheetOpen = false;
        this._token++;
        document.removeEventListener('keydown', this._onKey);
        this.viewer.hidden = true;
        this.viewer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = this._prevOverflow || '';
        this.closeMenu();
        clearTimeout(this._hintT);
        const v = this.r.video;
        v.pause();
        v.classList.remove('is-ready');
        v.removeAttribute('src');
        v.load();
        this.setAddState('idle');
        this.syncCarousel();
        if (this._opener && this._opener.focus && document.contains(this._opener)) this._opener.focus({ preventScroll: true });
      }

      navigate(dir) {
        if (this.cards.length < 2) return;
        const now = performance.now();
        if (now - (this._navAt || 0) < 220) return;
        this._navAt = now;
        this.showReel(this.state.index + dir);
      }

      showReel(index) {
        const n = this.cards.length;
        if (!n) return;
        const i = wrap(index, n);
        this.state.index = i;
        const card = this.cards[i];
        const r = this.r;

        const poster = card.dataset.poster || '';
        if (poster) {
          if (r.img.getAttribute('src') !== poster) r.img.src = poster;
          r.img.hidden = false;
        } else {
          r.img.removeAttribute('src');
          r.img.hidden = true;
        }

        const v = r.video;
        const src = card.dataset.videoSrc || '';
        this._token++;
        v.pause();
        v.classList.remove('is-ready');
        v.loop = !(this.autoNext && n > 1);
        this.resetProgress();
        this.setPaused(false);
        if (src) {
          if (v.getAttribute('src') !== src) v.src = src;
          else v.currentTime = 0;
          this.playActive();
        } else {
          v.removeAttribute('src');
          v.load();
        }

        if (n > 1) {
          this.fillSlot(r.prev, wrap(i - 1, n));
          this.fillSlot(r.next, wrap(i + 1, n));
        }
        this.setMuted(this.state.muted);
        this.renderSheet(card);
        this.updateLike(card);
        this.closeMenu();
      }

      fillSlot(slot, idx) {
        const img = slot.querySelector('[data-slot-image]');
        const poster = this.cards[idx].dataset.poster;
        if (poster) {
          if (img.getAttribute('src') !== poster) img.src = poster;
          img.hidden = false;
        } else img.hidden = true;
      }

      playActive() {
        const v = this.r.video;
        const token = ++this._token;
        v.muted = this.state.muted;
        const p = v.play();
        if (p && p.catch) {
          p.catch((err) => {
            if (token !== this._token || (err && err.name === 'AbortError')) return;
            this.setMuted(true);
            const q = v.play();
            if (q && q.catch) q.catch(() => {});
          });
        }
      }

      togglePlay() {
        const v = this.r.video;
        if (!v.getAttribute('src')) return;
        if (v.paused) {
          this.setPaused(false);
          const p = v.play();
          if (p && p.catch) p.catch(() => {});
        } else {
          this.setPaused(true);
          v.pause();
        }
      }

      setPaused(paused) {
        this.state.paused = paused;
        this.r.plays.forEach((b) => {
          b.classList.toggle('is-paused', paused);
          b.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
        });
      }

      setMuted(muted) {
        this.state.muted = muted;
        this.r.video.muted = muted;
        this.r.mute.classList.toggle('is-muted', muted);
        this.r.mute.setAttribute('aria-pressed', String(muted));
        this.r.mute.setAttribute('aria-label', muted ? 'Unmute video' : 'Mute video');
      }

      resetProgress() {
        const bar = this.r.progress;
        bar.style.transition = 'none';
        bar.style.transform = 'scaleX(0)';
        void bar.offsetWidth;
        bar.style.transition = '';
      }

      updateProgress() {
        const v = this.r.video;
        if (!Number.isFinite(v.duration) || v.duration <= 0) return;
        this.r.progress.style.transform = 'scaleX(' + Math.min(1, v.currentTime / v.duration) + ')';
      }

      /* ---------- Product sheet ---------- */
      getProduct(card) {
        const key = card.dataset.reelIndex;
        if (this.cache.has(key)) return this.cache.get(key);
        let p = null;
        const tag = card.querySelector('[data-product-json]');
        if (tag) { try { p = JSON.parse(tag.textContent); } catch (e) { console.warn('Shoppable reels: bad product JSON', e); } }
        this.cache.set(key, p);
        return p;
      }

      renderSheet(card) {
        const r = this.r;
        const p = this.getProduct(card);
        this.product = p;
        this.clearHint();
        this.setAddState('idle');
        if (!p || !p.variants || !p.variants.length) {
          this.product = null;
          r.sheet.hidden = true;
          r.bottom.hidden = true;
          this.viewer.classList.remove('is-sheet-open');
          return;
        }
        r.sheet.hidden = false;
        this.images = p.images && p.images.length ? p.images : (p.featured_image ? [p.featured_image] : []);
        this.imageIndex = 0;
        this.defaultVariant = p.variants.find((v) => v.available) || p.variants[0];
        this.sel = p.options.map((opt) => (opt.values.length === 1 ? opt.values[0] : null));

        r.title.textContent = p.title || '';
        r.full.href = p.url || '#';
        const thumb = this.images[0] || '';
        if (thumb) r.bottomImg.src = thumb;
        r.bottomTitle.textContent = p.title || '';
        const hasChoice = p.options.some((o) => o.values.length > 1);
        const hasSize = p.options.some((o) => /size/i.test(o.name));
        r.bottomCta.textContent = hasChoice ? (hasSize ? 'Select Size' : 'Select Options') : 'Add To Cart';
        r.scroll.scrollTop = 0;

        this.buildOptions();
        this.updateSheetImage();
        this.updateSheetState();
        this.setSheetOpen(this.state.sheetOpen);
      }

      buildOptions() {
        const box = this.r.options;
        box.textContent = '';
        this.product.options.forEach((opt, i) => {
          if (opt.name === 'Title' && opt.values.length === 1) return;
          const group = document.createElement('div');
          group.className = 'sr-opt';
          group.dataset.pos = String(i);
          const label = document.createElement('span');
          label.className = 'sr-opt-name';
          label.textContent = opt.name.toLowerCase() + ':';
          const row = document.createElement('div');
          row.className = 'sr-opt-pills';
          row.setAttribute('role', 'radiogroup');
          row.setAttribute('aria-label', opt.name);
          opt.values.forEach((val) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'sr-pill';
            b.setAttribute('role', 'radio');
            b.setAttribute('data-pill', '');
            b.dataset.pos = String(i);
            b.dataset.val = val;
            b.textContent = val;
            row.appendChild(b);
          });
          group.appendChild(label);
          group.appendChild(row);
          box.appendChild(group);
        });
        this.updatePills();
      }

      anyAvailable(sel) {
        return this.product.variants.some((v) => v.available && v.options.every((o, i) => !sel[i] || o === sel[i]));
      }

      getVariant() {
        if (!this.product || this.sel.some((s) => !s)) return null;
        return this.product.variants.find((v) => v.options.every((o, i) => o === this.sel[i])) || null;
      }

      selectOption(pos, val) {
        if (!this.product) return;
        const next = this.sel.slice();
        next[pos] = val;
        if (!this.anyAvailable(next)) {
          this.product.options.forEach((o, j) => { if (j !== pos && o.values.length > 1) next[j] = null; });
        }
        this.sel = next;
        this.clearHint();
        const v = this.getVariant();
        if (v && v.image) {
          const k = this.images.indexOf(v.image);
          if (k > -1) { this.imageIndex = k; this.updateSheetImage(); }
        }
        this.updatePills();
        this.updateSheetState();
      }

      updatePills() {
        this.r.options.querySelectorAll('[data-pill]').forEach((b) => {
          const pos = Number(b.dataset.pos);
          const test = this.sel.slice();
          test[pos] = b.dataset.val;
          const selected = this.sel[pos] === b.dataset.val;
          b.classList.toggle('is-selected', selected);
          b.classList.toggle('is-soldout', !this.anyAvailable(test));
          b.setAttribute('aria-checked', String(selected));
        });
      }

      updateSheetImage() {
        const r = this.r;
        const src = this.images[this.imageIndex] || '';
        if (src) {
          if (r.sheetImg.getAttribute('src') !== src) r.sheetImg.src = src;
          r.sheetImg.alt = (this.product && this.product.title) || '';
          r.sheetImg.hidden = false;
        } else r.sheetImg.hidden = true;
        r.imgPrev.hidden = !(this.imageIndex > 0);
        r.imgNext.hidden = !(this.imageIndex < this.images.length - 1);
      }

      stepImage(dir) {
        const next = this.imageIndex + dir;
        if (next < 0 || next >= this.images.length) return;
        this.imageIndex = next;
        this.updateSheetImage();
      }

      updateSheetState() {
        if (!this.product) return;
        const r = this.r;
        const v = this.getVariant();
        const shown = v || this.defaultVariant;
        r.price.textContent = shown.price;
        r.bottomPrice.textContent = shown.price;
        const hasOffer = shown.compare_cents > shown.price_cents;
        r.compare.hidden = !hasOffer;
        r.offer.hidden = !hasOffer;
        if (hasOffer) {
          r.compare.textContent = shown.compare_at_price || '';
          r.offer.textContent = Math.round(((shown.compare_cents - shown.price_cents) / shown.compare_cents) * 100) + '% OFF';
        }
        const needs = this.sel.some((s) => !s);
        const ready = !!v && v.available;
        const soldOut = !needs && (!v || !v.available);
        r.add.classList.toggle('is-disabled', !ready);
        r.add.setAttribute('aria-disabled', String(!ready));
        r.buy.classList.toggle('is-disabled', !ready);
        r.buy.setAttribute('aria-disabled', String(!ready));
        r.addLabel.textContent = soldOut ? 'Sold Out' : 'Add To Cart';
      }

      setSheetOpen(open) {
        const r = this.r;
        const on = !!open && !!this.product;
        this.state.sheetOpen = !!open;
        r.sheet.classList.toggle('is-open', on);
        r.sheet.toggleAttribute('inert', !on);
        r.sheet.setAttribute('aria-hidden', String(!on));
        r.bottom.hidden = on || !this.product;
        this.viewer.classList.toggle('is-sheet-open', on);
      }

      setAddState(state) {
        if (this.r && this.r.add) this.r.add.dataset.state = state;
      }

      showHint(msg) {
        const h = this.r.hint;
        h.textContent = msg;
        h.hidden = false;
        clearTimeout(this._hintT);
        this._hintT = setTimeout(() => this.clearHint(), 3200);
      }

      clearHint() {
        if (!this.r) return;
        clearTimeout(this._hintT);
        this.r.hint.hidden = true;
        this.r.options.querySelectorAll('.sr-opt.is-error').forEach((g) => g.classList.remove('is-error'));
      }

      nudgeMissing() {
        const idx = this.sel.findIndex((s) => !s);
        if (idx < 0) return;
        const group = this.r.options.querySelector('.sr-opt[data-pos="' + idx + '"]');
        if (group) {
          group.classList.remove('is-error');
          void group.offsetWidth;
          group.classList.add('is-error');
          group.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
        this.showHint('Please select ' + this.product.options[idx].name.toLowerCase());
      }

      /* ---------- Cart ---------- */
      async addToCart() {
        if (this._adding) return;
        const v = this.getVariant();
        if (!v) { this.nudgeMissing(); return; }
        if (!v.available) return;
        this._adding = true;
        this.setAddState('loading');
        try {
          const drawer = document.querySelector('cart-drawer');
          const body = { id: Number(v.id), quantity: 1 };
          if (drawer && typeof drawer.getSectionsToRender === 'function') {
            body.sections = drawer.getSectionsToRender().map((s) => s.id).join(',');
            body.sections_url = window.location.pathname;
          }
          const res = await fetch(shopRoot() + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(body)
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.status) throw new Error(data.description || data.message || 'Could not add to cart. Please try again.');

          let cart = null;
          try {
            const c = await fetch(shopRoot() + 'cart.js', { headers: { 'Accept': 'application/json' } });
            cart = await c.json();
          } catch (e) {}
          if (cart) this.updateCartCount(cart.item_count);

          this.setAddState('added');
          await wait(550);
          this.closeViewer();
          this.afterAdd(data, cart, v);
        } catch (err) {
          this.setAddState('idle');
          this.showHint(err && err.message ? err.message : 'Could not add to cart. Please try again.');
        } finally {
          this._adding = false;
        }
      }

      afterAdd(data, cart, variant) {
        try {
          if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, { source: 'shoppable-reels', productVariantId: variant.id, cartData: data });
          }
        } catch (e) {}
        const dawn = document.querySelector('cart-drawer');
        if (dawn && typeof dawn.renderContents === 'function' && data.sections) {
          dawn.renderContents(data);
          return;
        }
        const detail = {
          resource: cart,
          sourceId: this.id,
          data: { source: 'shoppable-reels', itemCount: cart ? cart.item_count : undefined, productId: data.product_id, variantId: variant.id, sections: data.sections }
        };
        ['cart:update', 'cart:refresh'].forEach((name) => document.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: detail })));
        setTimeout(() => this.openCart(), 150);
      }

      openCart() {
        const el = document.querySelector('cart-drawer') || document.querySelector('cart-drawer-component');
        if (el && typeof el.open === 'function') { el.open(); return; }
        if (el && typeof el.showDialog === 'function') { el.showDialog(); return; }
        window.location.href = (window.routes && window.routes.cart_url) || (shopRoot() + 'cart');
      }

      updateCartCount(count) {
        if (!Number.isFinite(Number(count))) return;
        const val = String(count);
        document.querySelectorAll('.cart-count, [data-cart-count]').forEach((n) => {
          n.textContent = val;
          n.setAttribute('data-cart-count', val);
          if (n.classList.contains('cart-count')) n.hidden = Number(count) === 0;
        });
        const bubble = document.querySelector('#cart-icon-bubble .cart-count-bubble');
        if (bubble) {
          const span = bubble.querySelector('span');
          if (span) span.textContent = val; else bubble.textContent = val;
          bubble.hidden = Number(count) === 0;
        }
        if (this.r && this.r.badge) this.r.badge.textContent = val;
      }

      buyNow() {
        const v = this.getVariant();
        if (!v) { this.nudgeMissing(); return; }
        if (!v.available) return;
        if (window.RazorpayMagicCheckout && typeof window.RazorpayMagicCheckout.open === 'function') {
          try {
            window.RazorpayMagicCheckout.open({ variantId: Number(v.id), quantity: 1 });
            return;
          } catch (e) { console.warn('Razorpay Magic Checkout error:', e); }
        }
        window.location.href = shopRoot() + 'cart/' + v.id + ':1';
      }

      /* ---------- Like / share ---------- */
      updateLike(card) {
        const base = parseInt(String(card.dataset.likes || '').replace(/[^\d]/g, ''), 10) || 380;
        const key = 'sr-like-' + this.sectionId + '-' + card.dataset.reelIndex;
        let liked = false;
        try { liked = window.localStorage.getItem(key) === '1'; } catch (e) {}
        this._like = { key: key, base: base, liked: liked };
        this.r.like.setAttribute('aria-pressed', String(liked));
        this.r.likeCount.textContent = String(base + (liked ? 1 : 0));
      }

      toggleLike() {
        const l = this._like;
        if (!l) return;
        l.liked = !l.liked;
        this.r.like.setAttribute('aria-pressed', String(l.liked));
        this.r.likeCount.textContent = String(l.base + (l.liked ? 1 : 0));
        try { window.localStorage.setItem(l.key, l.liked ? '1' : '0'); } catch (e) {}
      }

      toggleMenu() {
        this.r.menu.hidden = !this.r.menu.hidden;
        this.r.menuBtn.setAttribute('aria-expanded', String(!this.r.menu.hidden));
      }

      closeMenu() {
        if (!this.r) return;
        this.r.menu.hidden = true;
        this.r.menuBtn.setAttribute('aria-expanded', 'false');
      }

      async shareCurrent() {
        const card = this.cards[this.state.index];
        if (!card) return;
        const url = card.dataset.productUrl ? new URL(card.dataset.productUrl, window.location.origin).toString() : window.location.href;
        try {
          if (navigator.share) await navigator.share({ title: card.dataset.productTitle || document.title, url: url });
          else if (navigator.clipboard) await navigator.clipboard.writeText(url);
        } catch (e) {}
        this.closeMenu();
      }
    }

    customElements.define(TAG, ShoppableReels);
  })();
</script>

