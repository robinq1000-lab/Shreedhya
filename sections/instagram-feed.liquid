<div class="ig-sec" id="ig-{{ section.id }}" style="--ig-pt:{{ section.settings.pad_top }}px;--ig-pb:{{ section.settings.pad_bottom }}px;--ig-icon:{{ section.settings.icon_size }}px;">
  <div class="ig-grid">

    {%- comment -%} CENTRE BLOCK {%- endcomment -%}
    <div class="ig-center">
      <div class="ig-lottie" data-src="{{ 'Instagram_Logo_Effect.json' | asset_url }}" role="img" aria-label="Instagram"></div>
      {%- if section.settings.small_text != blank -%}<p class="ig-small">{{ section.settings.small_text | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ig-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.handle != blank -%}<p class="ig-handle">{{ section.settings.handle | escape }}</p>{%- endif -%}
      {%- if section.settings.button_text != blank -%}
        <a class="ig-follow" href="{{ section.settings.insta_url | default: '#' }}" target="_blank" rel="noopener">{{ section.settings.button_text | escape }}</a>
      {%- endif -%}
      {%- if section.settings.hint != blank -%}<p class="ig-hint">{{ section.settings.hint | escape }}</p>{%- endif -%}
    </div>

    {%- comment -%} 4 POST CARDS {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign ord = forloop.index
        if forloop.index > 2
          assign ord = forloop.index | plus: 1
        endif
      -%}
      <article class="ig-card ig-card--{{ forloop.index }}" style="order:{{ ord }};" {{ block.shopify_attributes }}>
        <div class="ig-head">
          <span class="ig-avatar">
            {%- if section.settings.avatar != blank -%}
              {{ section.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40, 80', alt: '' }}
            {%- endif -%}
          </span>
          <span class="ig-user">{{ section.settings.profile_name | escape }}</span>
          <span class="ig-dots" aria-hidden="true">···</span>
        </div>

        <div class="ig-media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 450, 600, 800', sizes: '(min-width: 990px) 240px, 45vw', class: 'ig-img', alt: block.settings.caption }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'ig-ph' }}
          {%- endif -%}

          {%- if block.settings.badge != blank -%}
            <span class="ig-badge"><i></i>{{ block.settings.badge | escape }}</span>
          {%- endif -%}

          <span class="ig-pop" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.3 3 4.5 6.7 4.5c2 0 3.5 1.1 5.3 3 1.8-1.9 3.3-3 5.3-3 3.700 0 5.8 3.8 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg>
          </span>

          {%- if block.settings.link != blank -%}
            <a class="ig-view" href="{{ block.settings.link }}">{{ section.settings.view_text | escape }}</a>
          {%- endif -%}
        </div>

        <div class="ig-foot">
          <div class="ig-actions">
            <button type="button" class="ig-like" aria-label="Like" aria-pressed="false">
              <svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.3 3 4.5 6.7 4.5c2 0 3.5 1.1 5.3 3 1.8-1.9 3.3-3 5.3-3 3.700 0 5.8 3.8 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg>
            </button>
            <span class="ig-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z"/></svg></span>
            <span class="ig-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M22 3 2 10.5l7.5 3L12.5 21 22 3zM22 3 9.5 13.5"/></svg></span>
            <span class="ig-ic ig-save" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v18l-6-4.5L6 21V3z"/></svg></span>
          </div>
          {%- if block.settings.caption != blank -%}
            <p class="ig-cap"><b>{{ section.settings.profile_name | escape }}</b> {{ block.settings.caption | escape }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}

  </div>
</div>

<style>
  .ig-sec{padding:var(--ig-pt) 0 var(--ig-pb);--k:1;overflow:hidden}
  .ig-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr)) minmax(220px,270px) repeat(2,minmax(0,1fr));gap:32px;align-items:center;max-width:1320px;margin:0 auto;padding:0 20px}

  /* ---- centre ---- */
  .ig-center{order:3;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 6px}
  .ig-lottie{width:var(--ig-icon);height:var(--ig-icon);margin-bottom:6px}
  .ig-small{margin:0 0 8px;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:#444}
  .ig-title{margin:0;font-size:clamp(30px,3.4vw,44px);font-weight:500;line-height:1.1;letter-spacing:-.01em;color:#222}
  .ig-handle{margin:8px 0 14px;font-size:15px;color:#e1306c}
  .ig-follow{display:inline-block;padding:14px 30px;border-radius:999px;background:linear-gradient(90deg,#fcb045 0%,#fd5c63 60%,#f5336f 100%);color:#fff;font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;text-decoration:none;box-shadow:0 8px 20px rgba(245,51,111,.28);transition:transform .25s ease,box-shadow .25s ease}
  .ig-follow:hover{transform:translateY(-2px);box-shadow:0 12px 24px rgba(245,51,111,.36)}
  .ig-hint{margin:14px 0 0;font-size:12px;color:#777}

  /* ---- cards ---- */
  .ig-card{--r:0deg;--y:0px;position:relative;background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 10px 28px rgba(0,0,0,.10);transform:translateY(var(--y)) rotate(calc(var(--r) * var(--k)));transition:transform .35s ease,box-shadow .35s ease}
  .ig-card--1{--r:-3deg;--y:26px}
  .ig-card--2{--r:2deg;--y:-6px}
  .ig-card--3{--r:-1.5deg;--y:-10px}
  .ig-card--4{--r:3deg;--y:28px}
  .ig-card:hover{transform:translateY(calc(var(--y) - 6px)) rotate(0deg);box-shadow:0 16px 36px rgba(0,0,0,.16);z-index:2}

  .ig-head{display:flex;align-items:center;gap:8px;padding:10px 12px}
  .ig-avatar{flex:0 0 26px;width:26px;height:26px;border-radius:50%;overflow:hidden;background:linear-gradient(45deg,#fcb045,#fd1d1d,#833ab4)}
  .ig-avatar img{display:block;width:100%;height:100%;object-fit:cover}
  .ig-user{font-size:13px;font-weight:700;color:#222}
  .ig-dots{margin-left:auto;font-size:14px;letter-spacing:1px;color:#999}

  .ig-media{position:relative;aspect-ratio:4/5;background:#efe9e6;overflow:hidden;cursor:pointer}
  .ig-img,.ig-ph{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center;display:block}
  .ig-badge{position:absolute;top:10px;left:10px;display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;background:#fff;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#222}
  .ig-badge i{width:6px;height:6px;border-radius:50%;background:#e1306c}

  .ig-view{position:absolute;left:50%;bottom:14px;transform:translate(-50%,10px);opacity:0;white-space:nowrap;padding:10px 20px;border-radius:999px;background:#fff;color:#222;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;box-shadow:0 6px 16px rgba(0,0,0,.2);transition:opacity .25s ease,transform .25s ease,background-color .2s ease,color .2s ease}
  .ig-view:hover{background:#222;color:#fff}
  .ig-media:hover .ig-view,.ig-media:focus-within .ig-view{opacity:1;transform:translate(-50%,0)}

  .ig-pop{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;opacity:0}
  .ig-pop svg{width:84px;height:84px;fill:#fff;filter:drop-shadow(0 4px 12px rgba(0,0,0,.35))}
  .ig-media.is-pop .ig-pop{animation:igPop .8s ease}
  @keyframes igPop{0%{opacity:0;transform:scale(.4)}25%{opacity:1;transform:scale(1.15)}60%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1)}}

  .ig-foot{padding:10px 12px 12px}
  .ig-actions{display:flex;align-items:center;gap:12px;margin-bottom:6px}
  .ig-actions svg{display:block;width:20px;height:20px;fill:none;stroke:#222;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .ig-like{padding:0;border:0;background:none;cursor:pointer;line-height:0}
  .ig-like.is-on svg{fill:#ed4956;stroke:#ed4956;animation:igBeat .35s ease}
  @keyframes igBeat{50%{transform:scale(1.25)}}
  .ig-ic{line-height:0}
  .ig-save{margin-left:auto}
  .ig-cap{margin:0;font-size:12px;line-height:1.4;color:#444;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .ig-cap b{color:#222}

  /* ---- touch devices: button hamesha dikhe ---- */
  @media (hover:none){
    .ig-view{opacity:1;transform:translate(-50%,0)}
  }

  /* ---- tablet + mobile ---- */
  @media (max-width:989px){
    .ig-sec{--k:.6}
    .ig-grid{grid-template-columns:repeat(2,minmax(0,1fr));max-width:620px;gap:14px;padding:0 14px}
    .ig-center{grid-column:1/-1;order:-1;margin-bottom:10px}
    .ig-sec .ig-card{--y:0px}
    .ig-view{bottom:10px;padding:8px 14px;font-size:10px}
  }
</style>

<script>
(function () {
  var w = window;
  if (!w.__igBoot) {
    var LIB = 'https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie_light.min.js';
    var libP;

    var loadLib = function () {
      if (w.lottie) return Promise.resolve();
      if (!libP) libP = new Promise(function (res, rej) {
        var s = document.createElement('script');
        s.src = LIB; s.onload = res; s.onerror = rej;
        document.head.appendChild(s);
      });
      return libP;
    };

    var initLottie = function (root) {
      var box = root.querySelector('.ig-lottie');
      if (!box || !('IntersectionObserver' in w)) return;
      var anim;
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            if (anim) { anim.play(); return; }
            loadLib().then(function () {
              if (anim) return;
              anim = w.lottie.loadAnimation({
                container: box, renderer: 'svg', loop: true, autoplay: true, path: box.dataset.src
              });
            }).catch(function () {});
          } else if (anim) {
            anim.pause();
          }
        });
      }, { threshold: 0.3 }).observe(box);
    };

    var initLikes = function (root) {
      root.addEventListener('click', function (e) {
        var btn = e.target.closest('.ig-like');
        if (btn) {
          btn.classList.toggle('is-on');
          btn.setAttribute('aria-pressed', btn.classList.contains('is-on'));
          return;
        }
        var media = e.target.closest('.ig-media');
        if (!media || e.target.closest('.ig-view')) return;
        var now = Date.now();
        if (now - (media._t || 0) < 320) {
          media._t = 0;
          var like = media.closest('.ig-card').querySelector('.ig-like');
          like.classList.add('is-on');
          like.setAttribute('aria-pressed', 'true');
          media.classList.remove('is-pop');
          void media.offsetWidth;
          media.classList.add('is-pop');
        } else {
          media._t = now;
        }
      });
    };

    w.__igBoot = function () {
      document.querySelectorAll('.ig-sec:not([data-ig])').forEach(function (root) {
        root.setAttribute('data-ig', '1');
        initLottie(root);
        initLikes(root);
      });
    };
    document.addEventListener('shopify:section:load', w.__igBoot);
  }
  w.__igBoot();
})();
</script>

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Centre block" },
    { "type": "text", "id": "small_text", "label": "Small text", "default": "Follow us on" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Instagram" },
    { "type": "text", "id": "handle", "label": "Instagram handle", "default": "@shreedhya" },
    { "type": "text", "id": "button_text", "label": "Follow button text", "default": "Follow the vibe" },
    { "type": "url", "id": "insta_url", "label": "Follow button link (Instagram profile)" },
    { "type": "text", "id": "hint", "label": "Hint text", "default": "Double-tap a photo to like it ♥" },
    { "type": "range", "id": "icon_size", "label": "Instagram icon size", "min": 50, "max": 160, "step": 5, "unit": "px", "default": 90 },

    { "type": "header", "content": "Post cards" },
    { "type": "text", "id": "profile_name", "label": "Profile name (card header + caption)", "default": "shreedhya" },
    { "type": "image_picker", "id": "avatar", "label": "Profile photo (small round logo)" },
    { "type": "text", "id": "view_text", "label": "Hover button text", "default": "View products" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Post image (800 x 1000 px)" },
        { "type": "text", "id": "caption", "label": "Caption (product name)" },
        { "type": "text", "id": "badge", "label": "Badge (e.g. NEW IN, optional)" },
        { "type": "url", "id": "link", "label": "View products link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
