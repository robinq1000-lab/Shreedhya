{%- comment -%}
  Simple Hero Slider
  - No load animations (no zoom, no fade, no text entrance)
  - Native scroll-snap slider + ~60 lines of vanilla JS (no libraries)
  - Whole slide is a clickable link
  - Separate desktop / mobile image, height in px or adapt-to-image
{%- endcomment -%}

{%- liquid
  assign first_block = section.blocks.first
  assign first_desktop = first_block.settings.image | default: first_block.settings.mobile_image
  assign first_mobile = first_block.settings.mobile_image | default: first_block.settings.image
  assign slide_count = section.blocks.size
  assign desktop_widths = '750,1100,1500,1920,2560' | split: ','
  assign mobile_widths = '480,750,1080' | split: ','
-%}

{%- style -%}
  #SHS-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }
  #SHS-{{ section.id }} * { box-sizing: border-box; }

  #SHS-{{ section.id }} .shs__inner {
    margin: 0 auto;
    {% if section.settings.layout == 'boxed' %}
      max-width: {{ section.settings.boxed_max_width }}px;
      padding: 0 16px;
    {% else %}
      max-width: 100%;
    {% endif %}
  }

  #SHS-{{ section.id }} .shs__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.contain_bg }};
    {% if section.settings.layout == 'boxed' %}
      border-radius: {{ section.settings.boxed_radius }}px;
    {% endif %}

    {% if section.settings.desktop_height_mode == 'pixels' %}
      height: {{ section.settings.desktop_height }}px;
    {% elsif first_desktop != blank %}
      aspect-ratio: {{ first_desktop.aspect_ratio }};
    {% else %}
      aspect-ratio: 1920 / 700;
    {% endif %}
  }

  #SHS-{{ section.id }} .shs__track {
    position: absolute;
    inset: 0;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #SHS-{{ section.id }} .shs__track::-webkit-scrollbar { display: none; }

  #SHS-{{ section.id }} .shs__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  #SHS-{{ section.id }} .shs__slide picture { display: block; width: 100%; height: 100%; }
  #SHS-{{ section.id }} .shs__slide img,
  #SHS-{{ section.id }} .shs__slide svg.placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.desktop_fit }};
    animation: none;
    transition: none;
    transform: none;
  }

  /* Arrows */
  #SHS-{{ section.id }} .shs__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.75);
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }
  #SHS-{{ section.id }} .shs__arrow:hover { background: #fff; }
  #SHS-{{ section.id }} .shs__arrow:focus-visible { outline: 2px solid #111; outline-offset: 2px; }
  #SHS-{{ section.id }} .shs__arrow--prev { left: 12px; }
  #SHS-{{ section.id }} .shs__arrow--next { right: 12px; }
  #SHS-{{ section.id }} .shs__arrow svg { width: 18px; height: 18px; display: block; }

  /* Dots */
  #SHS-{{ section.id }} .shs__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 8px;
    pointer-events: none;
  }
  #SHS-{{ section.id }} .shs__dot {
    pointer-events: auto;
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
  }
  #SHS-{{ section.id }} .shs__dot[aria-current='true'] { opacity: 1; }
  #SHS-{{ section.id }} .shs__dot:focus-visible { outline: 2px solid #111; outline-offset: 2px; }

  /* Mobile */
  @media screen and (max-width: 767px) {
    #SHS-{{ section.id }} .shs__inner {
      {% if section.settings.layout == 'boxed' %}padding: 0 10px;{% endif %}
    }
    #SHS-{{ section.id }} .shs__viewport {
      {% if section.settings.mobile_height_mode == 'pixels' %}
        height: {{ section.settings.mobile_height }}px;
        aspect-ratio: auto;
      {% elsif first_mobile != blank %}
        height: auto;
        aspect-ratio: {{ first_mobile.aspect_ratio }};
      {% else %}
        height: auto;
        aspect-ratio: 4 / 5;
      {% endif %}
    }
    #SHS-{{ section.id }} .shs__slide img,
    #SHS-{{ section.id }} .shs__slide svg.placeholder-svg {
      object-fit: {{ section.settings.mobile_fit }};
    }
    #SHS-{{ section.id }} .shs__arrow { width: 32px; height: 32px; }
    #SHS-{{ section.id }} .shs__arrow--prev { left: 6px; }
    #SHS-{{ section.id }} .shs__arrow--next { right: 6px; }
    {% unless section.settings.show_arrows_mobile %}
      #SHS-{{ section.id }} .shs__arrow { display: none; }
    {% endunless %}
  }
{%- endstyle -%}

<div
  id="SHS-{{ section.id }}"
  class="shs"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
>
  <div class="shs__inner">
    <div class="shs__viewport" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.accessibility_label | escape }}">

      <div class="shs__track">
        {%- for block in section.blocks -%}
          {%- liquid
            assign d_img = block.settings.image | default: block.settings.mobile_image
            assign m_img = block.settings.mobile_image | default: block.settings.image
            assign link = block.settings.link
            assign alt_text = block.settings.alt
            assign aria_text = alt_text | default: 'Slide'
            assign eager = false
            if forloop.first and section.index <= 2
              assign eager = true
            endif
          -%}

          {%- if link != blank -%}
            <a
              class="shs__slide"
              href="{{ link }}"
              aria-label="{{ aria_text | escape }} ({{ forloop.index }} / {{ slide_count }})"
              {{ block.shopify_attributes }}
            >
          {%- else -%}
            <div class="shs__slide" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- if d_img != blank -%}
              {%- assign d_list = '' -%}
              {%- for w in desktop_widths -%}
                {%- assign w_num = w | plus: 0 -%}
                {%- if w_num < d_img.width -%}
                  {%- capture item -%}{{ d_img | image_url: width: w_num }} {{ w_num }}w,{%- endcapture -%}
                  {%- assign d_list = d_list | append: item -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign d_max = d_img.width | at_most: 3840 -%}
              {%- capture item -%}{{ d_img | image_url: width: d_max }} {{ d_max }}w{%- endcapture -%}
              {%- assign d_list = d_list | append: item -%}

              {%- assign m_list = '' -%}
              {%- for w in mobile_widths -%}
                {%- assign w_num = w | plus: 0 -%}
                {%- if w_num < m_img.width -%}
                  {%- capture item -%}{{ m_img | image_url: width: w_num }} {{ w_num }}w,{%- endcapture -%}
                  {%- assign m_list = m_list | append: item -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign m_max = m_img.width | at_most: 1500 -%}
              {%- capture item -%}{{ m_img | image_url: width: m_max }} {{ m_max }}w{%- endcapture -%}
              {%- assign m_list = m_list | append: item -%}

              <picture>
                <source media="(max-width: 767px)" srcset="{{ m_list }}" sizes="100vw">
                <img
                  src="{{ d_img | image_url: width: 1920 }}"
                  srcset="{{ d_list }}"
                  sizes="100vw"
                  width="{{ d_img.width }}"
                  height="{{ d_img.height }}"
                  alt="{{ alt_text | escape }}"
                  {% if eager %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  decoding="async"
                >
              </picture>
            {%- else -%}
              {%- assign ph_mod = forloop.index0 | modulo: 2 -%}
              {%- if ph_mod == 0 -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- else -%}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            {%- endif -%}

          {%- if link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if slide_count > 1 -%}
        {%- if section.settings.show_arrows -%}
          <button type="button" class="shs__arrow shs__arrow--prev" data-shs-prev aria-label="Previous slide">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="shs__arrow shs__arrow--next" data-shs-next aria-label="Next slide">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        {%- endif -%}

        {%- if section.settings.show_dots -%}
          <div class="shs__dots">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="shs__dot"
                data-shs-dot="{{ forloop.index0 }}"
                aria-label="Go to slide {{ forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('SHS-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.shs__track');
    var slides = track.children;
    var n = slides.length;
    if (n < 2) return;

    var dots = root.querySelectorAll('[data-shs-dot]');
    var prevBtn = root.querySelector('[data-shs-prev]');
    var nextBtn = root.querySelector('[data-shs-next]');
    var autoplay = root.getAttribute('data-autoplay') === 'true';
    var speed = (parseInt(root.getAttribute('data-speed'), 10) || 5) * 1000;
    var pauseHover = root.getAttribute('data-pause-hover') === 'true';
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 0, timer = null, ticking = false, inView = true;

    function setActive(i) {
      current = i;
      for (var d = 0; d < dots.length; d++) {
        if (d === i) dots[d].setAttribute('aria-current', 'true');
        else dots[d].removeAttribute('aria-current');
      }
    }

    function go(i, instant) {
      i = (i + n) % n;
      track.scrollTo({ left: i * track.clientWidth, behavior: instant || reduced ? 'auto' : 'smooth' });
      setActive(i);
    }

    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        var i = Math.round(Math.abs(track.scrollLeft) / (track.clientWidth || 1));
        if (i !== current && i >= 0 && i < n) setActive(i);
        ticking = false;
      });
    }, { passive: true });

    if (prevBtn) prevBtn.addEventListener('click', function () { go(current - 1); restart(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { go(current + 1); restart(); });
    for (var k = 0; k < dots.length; k++) {
      (function (idx) {
        dots[idx].addEventListener('click', function () { go(idx); restart(); });
      })(k);
    }

    window.addEventListener('resize', function () { go(current, true); });

    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function start() {
      if (!autoplay || reduced || timer || !inView || document.hidden) return;
      timer = setInterval(function () {
        if (!document.body.contains(root)) { stop(); return; }
        go(current + 1);
      }, speed);
    }
    function restart() { stop(); start(); }

    if (autoplay) {
      if (pauseHover) {
        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);
      }
      root.addEventListener('touchstart', stop, { passive: true });
      root.addEventListener('touchend', function () { setTimeout(start, speed); }, { passive: true });
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          inView = entries[0].isIntersecting;
          inView ? start() : stop();
        }).observe(root);
      }
      start();
    }

    /* Theme editor: jump to the block being edited */
    root.addEventListener('shopify:block:select', function (e) {
      for (var s = 0; s < n; s++) {
        if (slides[s] === e.target) { stop(); go(s, true); break; }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Simple Hero Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Banner width",
      "options": [
        { "value": "full", "label": "Full width (100%)" },
        { "value": "boxed", "label": "Boxed / Container" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "boxed_max_width",
      "label": "Boxed max width",
      "min": 1000,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1400,
      "info": "Only used when Banner width is Boxed"
    },
    {
      "type": "range",
      "id": "boxed_radius",
      "label": "Boxed corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Only used when Banner width is Boxed"
    },

    { "type": "header", "content": "Desktop size" },
    {
      "type": "select",
      "id": "desktop_height_mode",
      "label": "Desktop height mode",
      "options": [
        { "value": "pixels", "label": "Fixed height (pixels)" },
        { "value": "adapt", "label": "Adapt to image aspect-ratio" }
      ],
      "default": "pixels"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 550,
      "info": "Used when mode is Fixed height"
    },
    {
      "type": "select",
      "id": "desktop_fit",
      "label": "Desktop image fit",
      "options": [
        { "value": "cover", "label": "Cover (fills the banner, may crop)" },
        { "value": "contain", "label": "Contain (shows full image)" }
      ],
      "default": "cover"
    },

    { "type": "header", "content": "Mobile size" },
    {
      "type": "select",
      "id": "mobile_height_mode",
      "label": "Mobile height mode",
      "options": [
        { "value": "pixels", "label": "Fixed height (pixels)" },
        { "value": "adapt", "label": "Adapt to image aspect-ratio" }
      ],
      "default": "pixels"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 400,
      "info": "Used when mode is Fixed height"
    },
    {
      "type": "select",
      "id": "mobile_fit",
      "label": "Mobile image fit",
      "options": [
        { "value": "cover", "label": "Cover (fills the banner, may crop)" },
        { "value": "contain", "label": "Contain (shows full image)" }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "contain_bg",
      "label": "Background behind image (for Contain)",
      "default": "#ffffff"
    },

    { "type": "header", "content": "Autoplay" },
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": true },
    {
      "type": "range",
      "id": "speed",
      "label": "Slide change speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover (desktop)", "default": true },

    { "type": "header", "content": "Navigation" },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true },
    { "type": "color", "id": "dot_color", "label": "Dots color", "default": "#ffffff" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "show_arrows_mobile", "label": "Show arrows on mobile", "default": false },

    { "type": "header", "content": "Spacing & accessibility" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Slider label (screen readers)",
      "default": "Featured banners"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Recommended: 1920 x 700 px (or your own banner size)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Recommended: 800 x 800 px or 4:5. If empty, desktop image is used"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner link",
          "info": "The entire slide becomes clickable"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text (SEO)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Simple Hero Slider",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
